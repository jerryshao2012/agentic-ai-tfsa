# Copy to .env and fill in real values. NEVER commit the real .env.
# For local runs only — in AgentCore these are passed via launch env_vars / the execution role.

# Provider selection (bedrock | watsonxai | openai | deepseek | ollama)
AI_SERVICES_PROVIDER=bedrock

# --- Amazon Bedrock ---
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# AWS credentials come from `aws configure` / SSO / env vars — do NOT put keys here.
# Resilience under throttling (adaptive retries + output cap). Raise attempts if still throttled.
# BEDROCK_MAX_ATTEMPTS=10
# BEDROCK_READ_TIMEOUT=60
# BEDROCK_MAX_TOKENS=1024

# --- Native extended thinking (Bedrock/Claude only; default off) ---
# Logs Claude reasoning blocks on llm_call_end. Forces temperature=1 and adds tokens/latency
# (more throttling pressure), so enable only for debugging. Needs a Claude model in BEDROCK_MODEL_ID.
# ENABLE_THINKING=false
# THINKING_BUDGET_TOKENS=1024
# THINKING_MAX_TOKENS=4096

# --- Tools ---
TAVILY_API_KEY=

# --- Synthetic data sources (S3) ---
# Leave DATA_S3_BUCKET empty to use the built-in mock profile + local tfsa_limits.json.
# When set, profiles/limits/transactions load from S3 (see data_sources.py).
# DATA_S3_BUCKET=tfsa-synthetic-data
# PROFILE_S3_PREFIX=profiles
# TRANSACTIONS_S3_PREFIX=transactions
# LIMITS_S3_KEY=reference/tfsa_limits.json
# DATA_S3_REGION=us-east-1

# --- Other providers (only if AI_SERVICES_PROVIDER points at them) ---
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

LOGGING_LEVEL=INFO
